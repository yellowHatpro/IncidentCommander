# Copy to .env. Every value here is optional: the app runs with this file unchanged.
# Lines left empty or at a placeholder value are treated as "not configured".

APP_ENV=development
# Bind address and preferred port for `python -m api`. If PORT is busy the API moves to
# the next free port (8001, 8002, ...) and prints the URL. Set PORT_STRICT=1 to fail instead.
HOST=127.0.0.1
PORT=8000
PORT_STRICT=0
REQUEST_TIMEOUT_SEC=60
# Relative paths resolve against the repository root. Parent directories are created.
DATABASE_PATH=data/incident_commander.db
WORKER_POLL_INTERVAL_SEC=2
WORKER_STALE_AFTER_SEC=300

# DigitalOcean Gradient agent. Leave both empty to use the built-in fallback analyzer.
# Format: AGENT_ENDPOINT=https://<agent-id>.agents.do-ai.run
AGENT_ENDPOINT=
AGENT_ACCESS_KEY=

# Slack incoming webhook for incident updates. Leave empty to disable.
SLACK_WEBHOOK_URL=

# Leave empty to keep write endpoints open. When set, send X-API-Key or Authorization: Bearer.
# The Next.js frontend reads the same variable to sign its requests.
INGEST_API_KEY=

# Browser origins allowed to call the API directly. In development any localhost port is
# accepted automatically; set this for a deployed frontend.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Frontend only (optional). Where the Next.js server finds the API. When unset it reads
# data/api-url written by `python -m api`, then falls back to http://127.0.0.1:8000.
# API_BASE_URL=http://127.0.0.1:8000
