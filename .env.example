APP_ENV=development
PORT=8000
REQUEST_TIMEOUT_SEC=60
DATABASE_PATH=data/incident_commander.db
WORKER_POLL_INTERVAL_SEC=2
WORKER_STALE_AFTER_SEC=300
AGENT_ENDPOINT=https://your-agent-id.agents.do-ai.run
AGENT_ACCESS_KEY=replace-me
SLACK_WEBHOOK_URL=
# Leave empty to keep write endpoints open. When set, send X-API-Key or Authorization: Bearer.
INGEST_API_KEY=
# Browser origins allowed to call the API directly (the Next.js dev server by default).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
